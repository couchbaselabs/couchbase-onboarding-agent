# Copy to `.env` in the project root before `docker compose up`:
#   cp env.example .env
# .env is git-ignored. Never commit real credentials.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security ---
# Bearer token for the API and websockets. Required for anything beyond a
# single-user laptop run: the API can read production credentials and delete
# destination data. Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=
# Fernet key that encrypts stored source/destination credentials. If empty, one
# is generated into the state volume on first start. Set it explicitly if the
# state volume is backed up or moved. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Brute-force throttling for the token check, per source IP (defaults shown).
# AUTH_MAX_FAILURES=10
# AUTH_FAILURE_WINDOW_S=900
# AUTH_LOCKOUT_S=1800
# The client IP is read from X-Forwarded-For (first hop) because nginx / the
# ingress always sits in front of the API. Set to false if you expose port 8000
# directly, so a caller can't spoof its own address.
# TRUST_X_FORWARDED_FOR=true
# Interactive API docs (/docs, /redoc, /openapi.json) are unauthenticated, so
# they're served only when ENVIRONMENT=development unless this is set.
# ENABLE_API_DOCS=false
STATE_ENCRYPTION_KEY=

# --- Agent memory: Couchbase Enterprise Edition (free for dev/test) ---
MEMORY_CB_USERNAME=Administrator
# Required. Pick a strong password; it's also the memory container's admin password.
MEMORY_CB_PASSWORD=
MEMORY_CB_BUCKET=agent_memory

# --- Local LLM, served via an Ollama-compatible API ---
# The assistant is optional. To run without it (no model download, ~3 GB less
# RAM; migrations, validation, bottleneck alerts and auto-throttling are
# unaffected -- only chat and similarity-based memory recall go away), set BOTH
# of these before `docker compose up --build`:
#   COMPOSE_PROFILES=
#   LLM_ENABLED=false
COMPOSE_PROFILES=llm
LLM_ENABLED=true
# Chat model for the assistant. qwen3:4b (~2.6 GB) is the smallest that stays
# useful; qwen3:8b (~5 GB) answers in more depth if you have the RAM.
QWEN_MODEL_NAME=qwen3:4b
# Embedding model for agent memory, and its vector length. Change both together
# (nomic-embed-text=768, qwen3-embedding:0.6b=1024, qwen3:4b=2560, qwen3:8b=4096);
# memory-init recreates the vector index, and earlier memories stop matching
# until re-embedded (see README "Changing the model").
QWEN_EMBEDDING_MODEL_NAME=nomic-embed-text
MEMORY_EMBEDDING_DIMS=768

# --- Couchbase Capella Management API (optional: destination bucket auto-provisioning) ---
# Generate a v4 API key: Capella > Organization Settings > API Keys
CAPELLA_API_TOKEN=
CAPELLA_ORG_ID=

# --- Continuous sync tuning (defaults shown; see backend/app/config.py for all) ---
# CDC_BATCH_SIZE=200
# CDC_MAX_CONSECUTIVE_FAILURES=20
# RECONCILE_MAX_DELETE_FRACTION=0.2
# CUTOVER_DRAIN_TIMEOUT_S=120
# VERIFY_SOURCE_COUNTS=true
# AUTO_RESUME_ON_STARTUP=true
