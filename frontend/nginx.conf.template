# Serves the built UI and proxies the API and websockets to the backend, so the
# browser talks to one origin (no CORS, no API URL baked into the bundle).
#
# HTTPS is the default: tls.conf.template adds a TLS server on 8443 (certificate
# from /etc/nginx/tls/server.{crt,key}, or a self-signed one generated at start
# by tls-entrypoint.sh), and this plain-HTTP server on 8080 redirects to it.
# The redirect is skipped when a reverse proxy / Ingress already terminated TLS
# (X-Forwarded-Proto: https) and for /healthz, so Ingress deployments and the
# container healthcheck keep using 8080 unchanged. TLS_ENABLED=false turns the
# TLS server and the redirect off (plain HTTP behind your own terminator).
#
# ${BACKEND_URL}, ${TLS_ENABLED}, ${HTTPS_PORT} are substituted at container
# start by the nginx image's envsubst; HTTPS_PORT is the port the *browser*
# uses (the published / Service port), so the redirect lands on the right one.

map "${TLS_ENABLED}:$http_x_forwarded_proto:$request_uri" $redirect_to_https {
    default                     0;
    "~^true:https:"             0;   # TLS already terminated in front of us
    "~^true:[^:]*:/healthz$"    0;   # probes / HEALTHCHECK
    "~^true:"                   1;
}

server {
    listen 8080;
    server_name _;

    if ($redirect_to_https) {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }

    # Only send HSTS when the request actually arrived over HTTPS at the proxy
    # in front of us. nginx drops a header whose value is empty.
    set $hsts "";
    if ($http_x_forwarded_proto = "https") {
        set $hsts "max-age=31536000; includeSubDomains";
    }

    include /etc/nginx/conf.d/site.inc;
}
